#!/bin/bash

set -euo pipefail

help() {
    cat <<EOF
usage: synergy <subcommand> [pkg]

subcommands:
  install [pkg]                 install a package
  remove [pkg]                  remove a package
  list                          list installed packages
  update                        update repositories
  upgrade                       upgrade all packages
  help                          show this dialogue
  version                       show program version
EOF
}

throbber() {
    /usr/libexec/ostools/throbber $@
}

install_package() {
    if [ -z "${1:-}" ]; then
        echo "Usage: $0 install <pkg>"
        help
        exit 1
    fi
    throbber --msg="Installing $1..." --cmd="nix-env -iA nixpkgs.$1"
}

remove_package() {
    if [ -z "${1:-}" ]; then
        echo "Usage: $0 remove <pkg>"
        help
        exit 1
    fi
    echo "Removing $1..."
    throbber --msg="Removing $1..." --cmd="nix-env -e "$1" && nix-collect-garbage"
    echo "Removed $1!"
}

list_packages() {
    echo "Packages:"
    nix-env -q
}

update_repositories() {
    throbber --msg="Updating Nix channels..." --cmd="nix-channel --update && nix-collect-garbage"
}

upgrade_packages() {
    throbber --msg="Upgrading packages..." --cmd="nix-env --upgrade && nix-collect-garbage"
}

if [[ "$EUID" -ne 0 ]]; then
    echo "Not authorized. Please run as root."
    exit 1
fi

case "${1:-}" in
    install)
        install_package "${2:-}"
        ;;
    remove)
        remove_package "${2:-}"
        ;;
    list)
        list_packages
        ;;
    update)
        update_repositories
        ;;
    upgrade)
        upgrade_packages
        ;;
    version)
        echo "synergy version 1.3.1"
    help | "")
        help
        ;;
    *)
        echo "Unknown subcommand: $1"
        help
        exit 1
        ;;
esac
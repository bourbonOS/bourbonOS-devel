#!/bin/bash

set -euo pipefail

help() {
    cat <<EOF
usage: synergy <subcommand> [pkg]

subcommands:
  install [pkg]                 install a package
  remove [pkg]                  remove a package
  list                          list installed packages
  update                        update repositories
  upgrade                       upgrade all packages
  help                          show this dialogue
EOF
}

install_package() {
    if [ -z "${1:-}" ]; then
        echo "Usage: $0 install <pkg>"
        help
        exit 1
    fi
    echo "Installing $1..."
    nix-env -iA nixpkgs."$1"
    echo "Installed $1!"
}

remove_package() {
    if [ -z "${1:-}" ]; then
        echo "Usage: $0 remove <pkg>"
        help
        exit 1
    fi
    echo "Removing $1..."
    nix-env -e "$1"
    nix-collect-garbage
    echo "Removed $1!"
}

list_packages() {
    echo "Packages:"
    nix-env -q
}

update_repositories() {
    echo "Updating Nix channels..."
    nix-channel --update
    nix-collect-garbage
}

upgrade_packages() {
    echo "Upgrading packages..."
    nix-env --upgrade
    nix-collect-garbage
}

if [[ "$EUID" -ne 0 ]]; then
    echo "Not authorized. Please run as root."
    exit 1
fi

case "${1:-}" in
    install)
        install_package "${2:-}"
        ;;
    remove)
        remove_package "${2:-}"
        ;;
    list)
        list_packages
        ;;
    update)
        update_repositories
        ;;
    upgrade)
        upgrade_packages
        ;;
    help | "")
        help
        ;;
    *)
        echo "Unknown subcommand: $1"
        help
        exit 1
        ;;
esac
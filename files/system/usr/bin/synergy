#!/bin/bash

# set help text
help () {
    cat <<EOF
usage: synergy <subcommand> [pkg]

subcommands:
  install [pkg]                 install a package
  remove [pkg]                  remove a package
  list                          list installed packages
  update                        update repositories
  upgrade                       upgrade all packages
  help                          show this dialogue
EOF
}

# main function
if [[ "$EUID" == "0" ]]; then
    case $1 in
        install)
            if [ -z "$2" ]; then
                echo "Usage: $0 install <pkg>"
                help
                exit 1
            fi
            echo "Installing $2..."
            nix-env -iA nixpkgs."$2"
            echo "Installed $2!"
            ;;
        remove)
            if [ -z "$2" ]; then
                echo "Usage: $0 remove <pkg>"
                help
                exit 1
            fi
            echo "Removing $2..."
            nix-env -e "$2"
            nix-collect-garbage
            echo "Removed $2!"
            ;;
        list)
            echo "Packages:"
            nix-env -q
            ;;
        update)
            echo "Updating Nix channels..."
            nix-channel --update
            nix-collect-garbage
            ;;
        upgrade)
            echo "Upgrading packages..."
            nix-env --upgrade
            nix-collect-garbage
            ;;
        help)
            help
            ;;
        *)
            help
            exit 1
            ;;
    esac
else
    echo "Not authorized. Please run as root."
    exit 1
fi
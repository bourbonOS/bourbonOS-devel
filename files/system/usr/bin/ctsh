#!/bin/bash

for arg in "$@"; do
    if [[ "$arg" == "--host" ]]; then
        readonly HOST="true"
        break
    elif [[ "$arg" != "--host" ]]; then
        readonly HOST="false"
        break
    fi
done

source "$HOME"/.ctshrc
source /usr/libexec/ctsh/ctshrc
source /usr/libexec/ctsh/modules
source /usr/libexec/ctsh/help-modules

container_exec() {
    if [[ "$CONTAINER" == "subsystem" ]]; then
        podman exec -it \
        --user "$(id -u)" \
        --workdir "$HOME" \
        -e HOME="$HOME" \
        -e USER="$USER" \
        "$1" "$2"
    else
        distrobox-enter --name "$CONTAINER" -- "$1"
    fi
}

process_command() {
    local command="$1"
    local basecmd=$(echo "$command" | awk '{print $1}')

    if [[ -z "$command" ]]; then
        return 0
    fi

    if [[ "$command" == "exit" ]]; then
        echo "Goodbye!"
        return 1
    fi

    if [[ -n "$basecmd" ]]; then
        if [[ "$basecmd" == "container" ]]; then
            container "${command#* }"
        elif [[ "$basecmd" == "baseos" ]]; then
            baseos "${command#* }"
        elif [[ "$basecmd" == "transit" ]]; then
            transit "${command#* }"
        elif [[ "$basecmd" == "synergy" ]]; then
            synergy "${command#* }"
        elif $HOST; then
            if command -v "${basecmd}" &> /dev/null; then
                ${command}
            else
                echo "Command not found: ${basecmd}"
            fi
        elif ! $HOST; then
            if container_exec "${CONTAINER}" "command -v '${basecmd}'" &> /dev/null; then
                container_exec "${CONTAINER}" "${command}"
            else
                echo "Command not found: ${basecmd}"
            fi
        fi
    fi
    
    return 0
}

while true; do
    PROMPT=$("$PROMPT_SCRIPT")
    command=$(rlwrap -S "$PROMPT" -H "$HISTFILE" "$WRAPPER_SCRIPT")
    
    process_command "$command"
    if [[ $? -ne 0 ]]; then
        break
    fi
    
    if [[ -n "$command" && "$command" != "$(tail -n 1 "$HISTFILE" 2>/dev/null)" ]]; then
        echo "$command" >> "$HISTFILE"
    fi
done
#!/bin/bash

status() {
    if [[ $* == *--no-truncate* ]]; then
        local sys_cmdline=$(cat /proc/cmdline | sed -E 's/(ostree=)[^ ]+/\1.../' | sed -E 's/(BOOT_IMAGE=)[^ ]+/\1.../' | sed -E 's/(uuid=)[^ ]+/\1.../' | sed -E 's/(luks_uuid=)[^ ]+/\1.../')
    else
        local sys_cmdline=$(cat /proc/cmdline)
    fi
    cat <<EOF
bourbonOS $(cat /etc/bourbonOS_version)
=======================
host: $(hostname)
kargs: "$sys_cmdline"
kernver: $(uname -r)
=======================
system status:
$(bootc status)
EOF
}

help() {
    cat <<EOF
bos utility v0.6.0

options:
    help                            show this message
    exec <command>                  execute a command on your base system
    tlbx                            command wrappers for various preinstalled utilities
    update                          update base system software/utilities
    status [--no-truncate]          view base system status/vital info
EOF
}

tlbx-help() {
    cat <<EOF
bos toolbox v0.1.0

options:
    help                            show this message
    apx <args>                      container management tool
    restic <args>                   data backup management tool
    bootc [--root] <args>           base system management tool
    systemctl [--root] <args>       init system management tool
EOF
}

case $1 in
    help)
        help
        ;;
    exec)
        shift
        $@
        ;;
    tlbx)
        shift
        case $1 in
            help)
                tlbx-help
                ;;
            apx)
                shift
                apx $@
                ;;
            restic)
                shift
                restic $@
                ;;
            bootc)
                shift
                if [[ "$1" == "--root" ]]; then
                    pkexec bootc $@
                else 
                    bootc $@
                fi
                ;;
            systemctl)
                shift
                if [[ "$1" == "--root" ]]; then
                    pkexec systemctl $@
                else
                    systemctl $@
                fi
                ;;
            *)
                tlbx-help
                ;;
        esac
        ;;
    update)
        clear
        pkexec /usr/libexec/ostools/update --interactive
        ;;
    status)
        shift
        status "$@"
        ;;
    *)
        echo "Invalid argument"
        help
        ;;
esac
#!/bin/bash

set -euo pipefail
source "$HOME"/.bkconf/bk.conf

status() {
    if [[ $* == *--no-truncate* ]]; then
        local sys_cmdline=$(cat /proc/cmdline | sed -E 's/(ostree=)[^ ]+/\1.../' | sed -E 's/(BOOT_IMAGE=)[^ ]+/\1.../' | sed -E 's/(uuid=)[^ ]+/\1.../' | sed -E 's/(luks_uuid=)[^ ]+/\1.../')
    else
        local sys_cmdline=$(cat /proc/cmdline)
    fi
    cat <<EOF
bourbonOS $(cat /etc/bourbonOS_version)
=======================
host: $(hostname)
kargs: "$sys_cmdline"
kernver: $(uname -r)
=======================
system status:
$(bootc status)
EOF
}

help() {
    cat <<EOF
bos (option) [flag]

Options:
    help                        show this dialogue
    version                     show program version
    exec                        execute command on your base system
    upgrade                     upgrade base system software/utilities
    status [--no-truncate]      view base system status
EOF
}

case $1 in
    help)
        help
        ;;
    version)
        echo "v0.2.0"
        ;;
    exec)
        shift
        $@
        ;;
    upgrade)
        clear
        echo "Please authorize this action with your root password."
        pkexec /usr/libexec/ostools/update --interactive
        ;;
    status)
        shift
        status "$@"
        ;;
esac
#!/bin/bash

set -euo pipefail

help() {
    cat <<EOF
cherry [option] (subcommand)

Options:
    help          Show this dialogue
    version       Show program version
    baseos        BaseOS commands
    container     Container commands
    transit       Transit commands
EOF
}

case $1 in
    help)
        help
        ;;
    version)
        echo "v0.1.0"
        ;;
    baseos)
        shift
        exec /usr/libexec/cherry/baseos "$@"
        ;;
    container)
        shift
        exec /usr/libexec/cherry/container "$@"
        ;;
    transit)
        shift
        exec /usr/libexec/cherry/transit "$@"
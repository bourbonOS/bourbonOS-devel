#!/bin/bash

set -oe pipefail

readonly CONTAINER_CONFIG_DIR="/etc/containerconf"
readonly USER_CONTAINER_CONFIG_DIR="$CONTAINER_CONFIG_DIR/$USER"
readonly CONTAINER_LIST_FILE="$CONTAINER_CONFIG_DIR/configs.d/.cherry/list.txt"
readonly CONTAINER_OVERRIDE_CONFIG="$HOME/.config/containerconf.d/override.conf"
readonly FILENAME_TMP=$(head /dev/urandom | tr -dc A-Za-z0-9 | head -c 35 ; echo '')
readonly PS3="> "

help() {
    cat <<EOF 
Usage: cherry <subcommand> [option]

Subcommands:
  baseos                        baseOS commands
  containeros                   containerOS commands
  fsguard                       FSguard commands
  version                       show program version
  help                          show this dialogue
EOF
}

stem-help() {
    cat <<EOF
Usage: cherry baseos [option]

Options:
  exec                          run a command on the host system
  upgrade                       upgrade the host system and related utils
  status                        show the status of the host system
  help                          show this dialogue
EOF
}

branch-help() {
    cat <<EOF
Usage: cherry containeros [option]

Options:
  new                           create a new container
  rm <container_name>           remove an existing container
  save <container_name>         save the specified container to an image
  load <image_path>             load a container from an image
  switch <container_name>       switch to a different container
  list                          list all containers
  help                          show this dialogue
EOF
}

pesticide-help() {
    cat <<EOF
Usage: cherry fsguard [option]

Options:
  status                      show the status of enrolled directories
  check                       check the integrity of enrolled directories
  apply                       enroll a new directory
  help                        show this dialogue
EOF
}

status() {
    local TRANSIT_STATUS="Not mounted"
    [[ -f /etc/transit_status ]] && TRANSIT_STATUS=$(cat /etc/transit_status)
    cat <<EOF
bourbonOS $(cat /etc/bourbonOS_version)
Pesticide: $(/usr/libexec/pesticide/status) | $(/usr/libexec/pesticide/version)
Transit: $TRANSIT_STATUS | $(cat /etc/transit_version)
=======================
host: $(hostname)
kargs: $(cat /proc/cmdline | sed -E 's/(ostree=)[^ ]+/\1.../' | sed -E 's/(BOOT_IMAGE=)[^ ]+/\1.../' | sed -E 's/(uuid=)[^ ]+/\1.../' | sed -E 's/(luks_uuid=)[^ ]+/\1.../')
kernver: $(uname -r)
=======================
ostree status:
$(ostree admin status)
EOF
}

version() {
    echo "cherry v3.1.4"
}

loadingbar() {
    command -v /usr/libexec/ostools/loadingbar &>/dev/null && /usr/libexec/ostools/loadingbar "$@" || echo "Loading..."
}

handle_baseos() {
    case "$1" in
        exec) shift; "$@" ;;
        upgrade) clear; echo "Please authorize to start your system upgrade."; pkexec /usr/libexec/ostools/update --interactive ;;
        status) status ;;
        help | *) stem-help ;;
    esac
}

handle_containeros() {
    case "$1" in
        new)
            echo "Do you want to:"
            select container in "Choose from a list of images" "Specify your own (advanced)"; do
                case "$container" in
                    "Choose from a list of images")
                        echo "Select an image from the list:"
                        select image in $(cat "$CONTAINER_LIST_FILE"); do
                            [[ -n $image ]] && loadingbar --msg="Creating your container, this may take a second." --cmd="distrobox-assemble create --file /etc/containerconf/$image.ini" && echo "Done! You can switch to the container using 'cherry branch jump'." && exit 0
                        done
                        ;;
                    "Specify your own (advanced)")
                        read -p "Container URL/alias: " manual_container_url
                        read -p "Container name: " manual_container_name
                        cp /etc/containerconf/.ini-template "/tmp/$FILENAME_TMP.ini"
                        sed -i "s/<name>/$manual_container_name/g" "/tmp/$FILENAME_TMP.ini"
                        sed -i "s/<url>/$manual_container_url/g" "/tmp/$FILENAME_TMP.ini"
                        nano "/tmp/$FILENAME_TMP.ini"
                        loadingbar --msg="Creating your container, this may take a second." --cmd="distrobox-assemble create --file /tmp/$FILENAME_TMP.ini"
                        rm "/tmp/$FILENAME_TMP.ini"
                        echo "Done! You can switch to the container using 'cherry branch jump'."
                        exit 0
                        ;;
                esac
            done
            ;;
        rm)
            containers=$(distrobox-list | awk '{print $3}' | grep -v -e '^NAME$' -e '^cherry-cli$')
            [[ -z $containers ]] && echo "No containers to remove." && exit 1
            echo "Select a container by its number to remove it."
            select container in $containers; do
                [[ -n $container ]] && loadingbar --msg="Removing your container, this may take a second." --cmd="distrobox-rm $container" && echo "Removed $container." && exit 0
            done
            ;;
        save)
            containers=$(distrobox-list | awk '{print $3}' | grep -v -e '^NAME$' -e '^cherry-cli$')
            [[ -z $containers ]] && echo "No containers to save." && exit 1
            echo "Select a container by its number to save it to an image."
            select container in $containers; do
                [[ -n $container ]] && loadingbar --msg="Saving your container as an image, this may take a second." --cmd="podman save $container $HOME/$container.tar" && echo "Container image saved at $HOME/$container.tar" && exit 0
            done
            ;;
        load)
            [[ ! -f "$2" ]] && echo "Error: Image path not found." && exit 1
            loadingbar --msg="Loading your container image, this may take a second." --cmd="podman load $2"
            echo "Container loaded from $2. You can switch to it using 'cherry branch jump'."
            ;;
        switch)
            containers=$(distrobox-list | awk '{print $3}' | grep -v -e '^NAME$' -e '^cherry-cli$')
            [[ -z $containers ]] && echo "No containers to switch to." && exit 1
            echo "Select a container by its number to switch to it."
            select container in $containers; do
                [[ -n $container ]] && exec distrobox-enter "$container"
            done
            ;;
        list) distrobox-list | awk '{print $3}' | grep -v -e '^NAME$' -e '^cherry-cli$' ;;
        help | *) branch-help ;;
    esac
}

handle_fsguard() {
    case "$1" in
        status) /usr/libexec/pesticide/status ;;
        check) /usr/libexec/pesticide/check ;;
        apply) shift; /usr/libexec/pesticide/enroll "$@" ;;
        help | *) pesticide-help ;;
    esac
}

case "$1" in
    baseos) shift; handle_baseos "$@" ;;
    containeros) shift; handle_containeros "$@" ;;
    fsguard) shift; handle_fsguard "$@" ;;
    version) version ;;
    help | *) help ;;
esac

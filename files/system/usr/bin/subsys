#!/bin/bash

set -e pipefail

is_container_stopped() {
    if podman container exists subsystem; then
        local state=$(podman inspect --format '{{.State.Status}}' subsystem 2>/dev/null)
        if [ "$state" = "running" ]; then
            return 1
        else
            return 0
        fi
    else
        return 0
    fi
}

perform_action() {
    local action=$1
    
    if [ "$(id -u)" -ne 0 ]; then
        pkexec systemctl $action subsystem.service
    else
        systemctl $action subsystem.service
    fi
}

case "$1" in
    start)
        if is_container_stopped; then
            echo "Starting subsystem..."
            perform_action start
        else
            echo "Subsystem is already running."
        fi
        ;;
    stop)
        if ! is_container_stopped; then
            echo "Stopping subsystem..."
            perform_action stop
        else
            echo "Subsytem is already stopped."
        fi
        ;;
    restart)
        echo "Restarting subsystem..."
        perform_action restart
        ;;
    status)
        echo "Subsystem status:"
        if is_container_stopped; then
            echo "Subsystem is stopped."
            systemctl status container-subsystem.service
        else
            echo "Subsystem is running."
            systemctl status container-subsystem.service
        fi
        ;;
    enter)
        if is_container_stopped; then
            echo "Subsystem is stopped. Starting it now..."
            perform_action start
            sleep 2
        fi
        
        echo "Entering subsystem as $(whoami)..."
        podman exec -it \
            --user $(id -u):$(id -g) \
            --env HOME=$HOME \
            --workdir $HOME \
            subsystem /bin/sh -c "cd $HOME && exec \$(getent passwd \$(id -un) | cut -d: -f7)"
        ;;
    logs)
        echo "Showing subsystem container logs:"
        journalctl -u container-subsystem.service
        ;;
    is-stopped)
        if is_container_stopped; then
            echo "Container 'subsystem' is stopped."
            exit 0
        else
            echo "Container 'subsystem' is running."
            exit 1
        fi
        ;;
    *)
        echo "Usage: subsystem-ctl [start|stop|restart|status|enter|logs|is-stopped]"
        exit 1
        ;;
esac

exit 0
#!/bin/bash

set -euo pipefail

status() {
    if [[ $* == *--no-truncate* ]]; then
        local sys_cmdline=$(cat /proc/cmdline | sed -E 's/(ostree=)[^ ]+/\1.../' | sed -E 's/(BOOT_IMAGE=)[^ ]+/\1.../' | sed -E 's/(uuid=)[^ ]+/\1.../' | sed -E 's/(luks_uuid=)[^ ]+/\1.../')
    else
        local sys_cmdline=$(cat /proc/cmdline)
    fi
    cat <<EOF
bourbonOS $(cat /etc/bourbonOS_version)
=======================
host: $(hostname)
kargs: "$sys_cmdline"
kernver: $(uname -r)
=======================
system status:
$(bootc status)
EOF
}

help() {
    cat <<EOF
bos utility v0.6.0

Options:
    help                            show this dialogue
    version                         show program version
    exec <command>                  execute a command on your base system
    distrobox                       manage containers with distrobox
    bootc                           manage base system with bootc
    update                          update base system software/utilities
    status [--no-truncate]          view base system status/vital info
EOF
}

case $1 in
    help)
        help
        ;;
    version)
        echo "bos utility v0.6.0"
        ;;
    exec)
        shift
        bash -c "$@"
        ;;
    distrobox)
        shift
        bash -c "distrobox $@"
        ;;
    bootc)
        shift
        bash -c "bootc $@"
        ;;
    update)
        clear
        echo "Please authorize this action with your root password."
        pkexec /usr/libexec/ostools/update --interactive
        ;;
    status)
        shift
        status "$@"
        ;;
    *)
        echo "Invalid argument"
        help
        ;;
esac
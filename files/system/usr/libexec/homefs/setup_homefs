#!/bin/bash

if [[ $EUID ! -eq 0 ]]; then
    echo "Error: Not authorized."
    exit 1
fi

set -oue pipefail

mkdir -p /var/usrlocal/{homefs,nixfs/{upper,work}}
chown root:root /var/usrlocal/{homefs,nixfs/{upper,work}}
chmod 700 /var/usrlocal/{homefs,nixfs/{upper,work}}

semanage fcontext -a -t etc_t "/nix/store/[^/]+/etc(/.*)?"
semanage fcontext -a -t lib_t "/nix/store/[^/]+/lib(/.*)?"
semanage fcontext -a -t systemd_unit_file_t "/nix/store/[^/]+/lib/systemd/system(/.*)?"
semanage fcontext -a -t man_t "/nix/store/[^/]+/man(/.*)?"
semanage fcontext -a -t bin_t "/nix/store/[^/]+/s?bin(/.*)?"
semanage fcontext -a -t usr_t "/nix/store/[^/]+/share(/.*)?"
semanage fcontext -a -t var_run_t "/nix/var/nix/daemon-socket(/.*)?"
semanage fcontext -a -t usr_t "/nix/var/nix/profiles(/per-user/[^/]+)?/[^/]+"
semanage fcontext -a -t etc_t "/usr/local/nixfs/upper/nix/store/[^/]+/etc(/.*)?"
semanage fcontext -a -t lib_t "/usr/local/nixfs/upper/store/[^/]+/lib(/.*)?"
semanage fcontext -a -t systemd_unit_file_t "/usr/local/nixfs/upper/store/[^/]+/lib/systemd/system(/.*)?"
semanage fcontext -a -t man_t "/usr/local/nixfs/upper/store/[^/]+/man(/.*)?"
semanage fcontext -a -t bin_t "/usr/local/nixfs/upper/store/[^/]+/s?bin(/.*)?"
semanage fcontext -a -t usr_t "/usr/local/nixfs/upper/store/[^/]+/share(/.*)?"
semanage fcontext -a -t var_run_t "/usr/local/nixfs/upper/var/nix/daemon-socket(/.*)?"
semanage fcontext -a -t usr_t "/usr/local/nixfs/upper/var/nix/profiles(/per-user/[^/]+)?/[^/]+"

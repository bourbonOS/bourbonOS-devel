#!/bin/bash

set -oue pipefail
shopt -s dotglob

TARGET_USER=$1
HOME_DIR=/var/home
HOMEFS_DIR=/var/usrlocal/homefs
MAPPER_DIR=/dev/mapper/homefs-decrypted-$TARGET_USER
PRODUCT_SKU=$(cat /sys/class/dmi/id/product_sku | tr -d ' ')
GEN_TMPDIRNAME=$(openssl rand -hex 32)

if [[ -d $HOME_DIR/$TARGET_USER ]]; then
    if [[ ! -f $HOMEFS_DIR/$TARGET_USER.img.homefs ]]; then
        echo "Creating HomeFS image..."
        truncate -s "$(df -h "$HOME_DIR" | awk 'NR==2 {print $2}')" $HOMEFS_DIR/$TARGET_USER.img.homefs
        chown $TARGET_USER:$TARGET_USER $HOMEFS_DIR/$TARGET_USER.img.homefs
        chmod 700 $HOMEFS_DIR/$TARGET_USER.img.homefs
        echo "Encrypting image..."
        echo "$(openssl rand -base64 12)-$(openssl rand -hex 18)" | keyctl add user "$PRODUCT_SKU-homefs-$TARGET_USER"
        keyctl pipe "$PRODUCT_SKU-homefs-$TARGET_USER" | cryptsetup --type luks2 --cipher aes-xts-plain64 luksFormat $HOMEFS_DIR/$TARGET_USER.img.homefs
        keyctl pipe "$PRODUCT_SKU-homefs-$TARGET_USER" | cryptsetup luksOpen $HOMEFS_DIR/$TARGET_USER.img.homefs homefs-decrypted-$TARGET_USER
        mkfs.ext4 $MAPPER_DIR -F
        echo "Mounting..."
        mkdir -p /tmp/homefs-private-$GEN_TMPDIRNAME/
        mount $MAPPER_DIR /tmp/homefs-private-$GEN_TMPDIRNAME/
        echo "Transferring data..."
        mv $HOME_DIR/$TARGET_USER/* /tmp/homefs-private-$GEN_TMPDIRNAME/
        echo "Remounting..."
        mount -o remount $MAPPER_DIR $HOME_DIR/$TARGET_USER/
        echo "Done."
        exit 0
    else
        if [[ "$PAM_TYPE" == "open_session" ]]; then
            echo "Unencrypting..."
            keyctl pipe "$PRODUCT_SKU-homefs-$TARGET_USER" | cryptsetup luksOpen $HOMEFS_DIR/$TARGET_USER.img.homefs homefs-decrypted-$TARGET_USER
            echo "Mounting..."
            mkdir -p $HOME_DIR/$TARGET_USER/
            mount $MAPPER_DIR $HOME_DIR/$TARGET_USER/
            echo "Done."
            exit 0
        elif [[ "$PAM_TYPE" == "close_session" ]]; then
            echo "Unmounting..."
            umount $HOME_DIR/$TARGET_USER
            rmdir $HOME_DIR/$TARGET_USER
            echo "Closing HomeFS device..."
            cryptsetup luksClose homefs-decrypted-$TARGET_USER
            echo "Done."
            exit 0
        else
            echo "Unknown session type, not handling."
            exit 0
        fi
    fi
else
    echo "No such user $TARGET_USER, not handling."
    exit 0
fi
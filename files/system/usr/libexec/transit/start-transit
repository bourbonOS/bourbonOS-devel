#!/bin/bash

set -oue pipefail

if [[ -t 0 || -z "$(cat -)" ]]; then
    echo "Error: No input received." >&2
    exit 0
elif [[ "$(id -u "$1")" -lt 1000 || ! grep -q "^$1:" /etc/passwd ]]; then
    exit 0
elif [[ ! -f "$transit_dir"/repo/"$1".homedir ]]; then
    echo "$pass" | /usr/libexec/transit/setup-transit "$1"
fi

pass=$(cat)
transit_dir="/var/usrlocal/transit"

echo "Associating image..."
LOOPDEV=$(losetup -f --show "$transit_dir"/repo/"$1".homedir)
[[ -z "$LOOPDEV" ]] && echo "Error: No loop device found for "$transit_dir"/repo/$1.homedir." && exit 1

echo "Decrypting image..."
echo "$pass" | cryptsetup luksOpen "$LOOPDEV" in_transit-$(cat /etc/transit/transit-id)

unset pass

echo "Mounting image..."
mount --bind -o ro /var/home "$transit_dir"/varhome
mount /dev/mapper/in_transit-$(cat /etc/transit/transit-id) /var/home

echo "Mounted image successfully."
echo "MOUNTED" > /etc/transit/transit-status
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.policykit.exec" && 
        action.lookup("command") === "/usr/bin/cherry" && 
        action.lookup("args") && 
        action.lookup("args").length === 2 &&
        action.lookup("args")[0] === "baseos" &&
        action.lookup("args")[1] === "root-enable") {
        return polkit.Result.YES;
    }
});
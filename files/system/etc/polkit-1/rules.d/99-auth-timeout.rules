polkit.addRule(function(action, subject) {
  if (subject.local && subject.active && subject.type == "unix-process" && subject.is_active) {
    if (action.lookup("auth_admin_keep_session") === "yes" ||
        action.lookup("auth_admin") === "yes" ||
        action.lookup("auth_owner_keep_session") === "yes" ||
        action.lookup("auth_owner") === "yes") {
      let now = Math.floor(Date.now() / 1000);
      let lastAuthenticated = subject.active[action.id];
      if (lastAuthenticated && (now - lastAuthenticated) < 60) {
        return polkit.Result.YES;
      }
    }
  }
});
[Unit]
Description=Setup ostools on first boot
After=local-fs-pre.target
Before=network.target
BindsTo=local-fs-pre.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/ostools/setup_ostools
ExecStartPost=/usr/bin/systemctl disable setup-ostools.service

[Install]
WantedBy=multi-user.target
[Unit]
Description=Move nix imgfs to usrlocal
Before=nix.mount
After=var.mount

[Service]
Type=oneshot
ConditionPathExists=/etc/.nix-mount-temp/nix-mount.imgfs
ExecStart=/bin/bash -c "mv /etc/.nix-mount-temp/nix-mount.imgfs /var/usrlocal && rmdir /etc/.nix-mount-temp"
ExecStartPost=/usr/bin/systemctl disable nix-loop-move.service

[Install]
WantedBy=multi-user.target